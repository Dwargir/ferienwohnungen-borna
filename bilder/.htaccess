# Im Fotoordner dürfen nur Bilder liegen und ausgeliefert werden – nie Skripte oder HTML
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|cgi|pl|py|sh|html?|xhtml|svg|js|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
  RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
